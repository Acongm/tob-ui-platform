{
  "name": "@tob-ui/ui-cli",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "tob-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --banner.js '#!/usr/bin/env node' --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tob-ui/ui-meta": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
